@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnePlus</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/Layout/Style.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">One<span class="brand-plus">Plus</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            @if (HttpContextAccessor.HttpContext.Session.GetString("UserRole") == "Admin")
                            {
                                <a class="nav-link" asp-area="" asp-controller="Product" asp-action="Index">Home</a>
                            }
                            else
                            {
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            }
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">About</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (HttpContextAccessor.HttpContext.Session.GetString("UserId") != null && HttpContextAccessor.HttpContext.Session.GetString("UserRole") != "Admin")
                        {
                            <li class="nav-item cart-icon-container">
                                <a class="nav-link" asp-area="" asp-controller="Cart" asp-action="Index">
                                    <i class="fas fa-shopping-cart cart-icon"></i>
                                    <span class="cart-item-count" id="cartItemCount">0</span>
                                </a>
                            </li>
                        }
                        <li class="nav-item dropdown profile-dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle profile-icon"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                @if (HttpContextAccessor.HttpContext.Session.GetString("UserId") != null)
                                {
                                    <li><a class="dropdown-item" asp-controller="Uam" asp-action="Profile">My Profile</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Uam" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item" asp-controller="Uam" asp-action="Login">Sign In</a></li>
                                }
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid main-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- ===================================================================== -->
    <!-- === REWRITTEN & CORRECTED SCRIPT FOR GLOBAL CART COUNT MANAGEMENT === -->
    <!-- ===================================================================== -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const cartCountElement = document.getElementById('cartItemCount');

            // This function is responsible for updating the cart count display.
            // It also handles showing/hiding the badge based on the count.
            function updateCartCountDisplay(count) {
                if (cartCountElement) {
                    // Ensure count is a number
                    const numericCount = parseInt(count) || 0;
                    cartCountElement.textContent = numericCount;

                    // Pro Tip: Hide the badge when the cart is empty for a cleaner UI.
                    if (numericCount > 0) {
                        cartCountElement.style.display = 'block';
                    } else {
                        cartCountElement.style.display = 'none';
                    }
                }
            }

            // This function fetches the latest cart count from our API.
            async function fetchAndUpdateCartCount() {
                // Only run this if the cart icon is actually on the page.
                if (!cartCountElement) return;

                try {
                    // We use the new '/Cart/Count' endpoint which is clean and dedicated.
                    const response = await fetch('/Cart/Count');
                    if (!response.ok) {
                        throw new Error(`Network response was not ok: ${response.statusText}`);
                    }
                    const data = await response.json();
                    if (data.success) {
                        updateCartCountDisplay(data.count);
                    }
                } catch (error) {
                    console.error("Error fetching cart count:", error);
                    // In case of error, we ensure the count is hidden.
                    updateCartCountDisplay(0);
                }
            }

            // --- EVENT LISTENER ---
            // This is the modern way to handle updates. Instead of listening for specific clicks,
            // we listen for a custom event. The Home.js and Cart.js scripts will 'dispatch' this
            // event whenever they successfully modify the cart.
            document.addEventListener('cartUpdated', function (event) {
                const newCount = event.detail.newItemCount;
                updateCartCountDisplay(newCount);
            });


            // --- INITIAL LOAD ---
            // Fetch the count as soon as the page loads to ensure it's always accurate.
            fetchAndUpdateCartCount();
        });
    </script>
</body>
</html>
