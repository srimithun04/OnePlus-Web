@model IEnumerable<OnePlus.Models.Cart>
@{
    ViewData["Title"] = "My Shopping Cart";
    // The initial total is calculated here but will be dynamically updated by JavaScript.
    decimal cartTotal = ViewData["CartTotal"] != null ? (decimal)ViewData["CartTotal"] : 0;
}

@section Styles {
    <!-- Referencing your existing CSS file for consistent styling -->
    <link rel="stylesheet" href="~/css/Cart/Cart.css" asp-append-version="true" />
    <!-- SweetAlert2 for beautiful, responsive popups -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
}

<div class="cart-page-container">
    <header class="cart-header">
        <h1>My Cart</h1>
        <a href="@Url.Action("All_Products", "Home")" class="continue-shopping">
            <i class="fas fa-arrow-left"></i> Continue Shopping
        </a>
    </header>

    <div id="cart-dynamic-content">
        @if (!Model.Any())
        {
            <!-- This section is shown only when the cart is initially empty -->
            <div class="empty-cart-message animate-fade-in">
                <p>Your cart is empty. Let's find something for you!</p>
                <a href="@Url.Action("All_Products", "Home")" class="btn btn-primary-hero">Shop Now</a>
            </div>
        }
        else
        {
            <!-- Main cart content, will be managed by JavaScript -->
            <div class="cart-content">
                <section class="cart-items">
                    <div class="cart-table-header">
                        <div class="col-product">PRODUCT</div>
                        <div class="col-price">PRICE</div>
                        <div class="col-qty">QUANTITY</div>
                        <div class="col-total">TOTAL</div>
                        <div class="col-actions"></div>
                    </div>

                    @foreach (var item in Model)
                    {
                        <div class="cart-item-row animate-fade-in" data-cart-item-id="@item.CartItemId" data-product-price="@item.Product.Price">
                            <div class="col-product">
                                <img src="@(item.Product.ImageUrl ?? "/images/placeholder.png")" alt="@item.Product.Name" class="cart-product-image" />
                                <div class="product-details">
                                    <h5 class="product-name">@item.Product.Name</h5>
                                    <p class="product-sku">#@item.Product.Sku</p>
                                </div>
                            </div>
                            <div class="col-price">@item.Product.Price.ToString("C", new System.Globalization.CultureInfo("en-IN"))</div>
                            <div class="col-qty">
                                <div class="quantity-control">
                                    <button class="quantity-minus" title="Decrease quantity">-</button>
                                    <input type="number" class="quantity-input" value="@item.Quantity" min="1" aria-label="Item quantity" />
                                    <button class="quantity-plus" title="Increase quantity">+</button>
                                </div>
                            </div>
                            <div class="col-total item-total">@((item.Product.Price * item.Quantity).ToString("C", new System.Globalization.CultureInfo("en-IN")))</div>
                            <div class="col-actions">
                                <button type="button" class="btn-remove-item" title="Remove item">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    }
                </section>

                <aside class="cart-summary animate-slide-in">
                    <div class="shipping-mode-selection">
                        <h3>Choose shipping mode:</h3>
                        <label class="radio-option">
                            <input type="radio" name="shipping-mode" value="store-pickup" checked>
                            <span class="custom-radio"></span>
                            Store pickup • <span class="free-shipping">FREE</span>
                        </label>
                        <label class="radio-option">
                            <input type="radio" name="shipping-mode" value="delivery">
                            <span class="custom-radio"></span>
                            Home Delivery • <span class="delivery-cost">₹750.00</span>
                        </label>
                    </div>

                    <div class="order-summary-details">
                        <div class="summary-line">
                            <span>SUBTOTAL</span>
                            <span id="subtotal-ttc">@cartTotal.ToString("C", new System.Globalization.CultureInfo("en-IN"))</span>
                        </div>
                        <div class="summary-line">
                            <span>SHIPPING</span>
                            <span id="shipping-cost">Free</span>
                        </div>
                        <div class="summary-line total-line">
                            <span>TOTAL</span>
                            <span id="overall-total">@cartTotal.ToString("C", new System.Globalization.CultureInfo("en-IN"))</span>
                        </div>
                    </div>

                    <button class="btn-checkout">Checkout <span id="checkout-button-total">@cartTotal.ToString("C", new System.Globalization.CultureInfo("en-IN"))</span></button>
                    <button class="btn-clear-cart">Clear Cart</button>
                </aside>
            </div>
        }
    </div>
</div>

@section Scripts {
    <!-- FontAwesome for icons -->
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <!-- SweetAlert2 for beautiful popups -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- The new, robust cart JavaScript -->
    <script src="~/js/Cart/Cart.js" asp-append-version="true"></script>
}
